{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(swift:*)",
      "Bash(swiftly:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(scripts/setup.sh)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh api -X PUT:*)",
      "Bash(gh api --method PUT:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force origin main:*)",
      "Bash(gh repo delete:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
